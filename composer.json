{
    "name": "sentinela/laravel-client",
    "description": "Cliente oficial de Sentinela para Laravel: captura logs y excepciones y las envía a tu instancia de Sentinela.",
    "type": "library",
    "license": "MIT",
    "keywords": ["sentinela", "laravel", "logging", "monitoring", "error-tracking"],
    "homepage": "https://github.com/seriux90-hub/sentinela-sdk",
    "authors": [
        {
            "name": "Sentinela"
        }
    ],
    "require": {
        "php": "^8.1",
        "illuminate/support": "^10.0|^11.0|^12.0",
        "illuminate/contracts": "^10.0|^11.0|^12.0"
    },
    "require-dev": {
        "orchestra/testbench": "^8.0|^9.0|^10.0",
        "phpunit/phpunit": "^10.0|^11.0"
    },
    "autoload": {
        "psr-4": {
            "Sentinela\\LaravelClient\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Sentinela\\LaravelClient\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Sentinela\\LaravelClient\\SentinelaServiceProvider"
            ],
            "aliases": {
                "Sentinela": "Sentinela\\LaravelClient\\Facades\\Sentinela"
            }
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true,
    "config": {
        "sort-packages": true
    }
}
